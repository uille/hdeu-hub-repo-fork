<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:dc="http://purl.org/dc/elements/1.1/"
    xmlns:dct="http://purl.org/dc/terms/"
    xml:base="http://publications.europa.eu/resource/authority/data-theme/">

    <!-- Concept Scheme -->
    <rdf:Description rdf:about="http://publications.europa.eu/resource/authority/data-theme">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <dct:title xml:lang="en">Data Theme</dct:title>
        <dct:description xml:lang="en">Controlled vocabulary for data themes used in DCAT-AP</dct:description>
    </rdf:Description>

    <!-- Sample Data Theme Concepts -->
    <rdf:Description rdf:about="http://publications.europa.eu/resource/authority/data-theme/AGRI">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en">Agriculture</skos:prefLabel>
        <skos:definition xml:lang="en">Data related to agriculture</skos:definition>
        <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/data-theme"/>
    </rdf:Description>

    <rdf:Description rdf:about="http://publications.europa.eu/resource/authority/data-theme/ECON">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en">Economy</skos:prefLabel>
        <skos:definition xml:lang="en">Data related to economy</skos:definition>
        <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/data-theme"/>
    </rdf:Description>

    <rdf:Description rdf:about="http://publications.europa.eu/resource/authority/data-theme/ENVI">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <skos:prefLabel xml:lang="en">Environment</skos:prefLabel>
        <skos:definition xml:lang="en">Data related to environment</skos:definition>
        <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/data-theme"/>
    </rdf:Description>

</rdf:RDF>

